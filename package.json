{
  "name": "sunsoul",
  "private": true,
  "description": "Sunsoul — Lao marketplace where Sunsoul holds the buyer's money until the goods arrive",
  "scripts": {
    "test": "node tests/run-all.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-sunsoul \"node tests/rules/firestore.rules.emu.js\"",
    "test:e2e": "firebase emulators:exec --only firestore,auth --project demo-sunsoul \"node tests/rules/e2e.emu.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "12.19.0",
    "firebase-tools": "15.34.2",
    "jsqr": "1.4.0",
    "playwright": "1.56.1"
  }
}
